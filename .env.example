# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# --- Pinecone -------------------------------------------------------------
PINECONE_API_KEY=pcsk_...
# Opciono — samo ako indeks/host odstupaju od koda podrazumevanih vrednosti
PINECONE_HOST=
PINECONE_INDEX=
PINECONE_INDEX_NAME=

# --- Supabase -------------------------------------------------------------
# Dashboard -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- Cohere (opciono — za Re-Ranking, Sprint 3) ---------------------------
# Bez ovoga pipeline radi bez re-rankinga (interni skor kao fallback)
COHERE_API_KEY=your_cohere_api_key_here

# --- CORS -----------------------------------------------------------------
ALLOWED_ORIGINS=https://vindex.rs

# --- Sigurnosni ključevi (OBAVEZNO pre produkcije) -------------------------
# SECRET_KEY: HMAC potpisivanje client-portal tokena (routers/client_portal.py).
# Bez ovoga aplikacija baca RuntimeError na prvi poziv koji ga koristi.
SECRET_KEY=change-me-to-a-long-random-value

# BRIEFING_CRON_SECRET: štiti /api/cron/daily i sve /*/cron rute (X-Cron-Secret
# header). OBAVEZNO podesiti pre produkcije — bez njega endpoint fail-CLOSED-uje
# (401), pa dnevni cron (retention cleanup, background agenti, podsetnici) neće
# raditi dok se ovo ne popuni. V. docs/PRODUCTION_READINESS_REPORT_2026-07-25.md.
BRIEFING_CRON_SECRET=change-me-to-a-long-random-value

# CRON_SECRET: X-Cron-Key header za email_notif/whatsapp_notif cron rute
# (odvojen sekret od BRIEFING_CRON_SECRET — istorijski, ne nužno namerno
# odvojen dizajn, ali oba moraju biti podešena da te rute rade).
CRON_SECRET=change-me-to-a-long-random-value

# ADMIN_DEBUG_KEY: X-Admin-Key za interne dijagnostičke rute (api.py).
ADMIN_DEBUG_KEY=

# FOUNDER_TOKEN: rezervni bootstrap token za founder pristup (van normalnog JWT).
FOUNDER_TOKEN=

# BOT_API_KEY: X-Api-Key header za bot/automatizovane integracije (api.py).
BOT_API_KEY=

# UNSUBSCRIBE_SECRET: potpisuje one-click unsubscribe linkove (routers/gdpr.py).
# Ako se ne podesi, pada nazad na SUPABASE_JWT_SECRET — svejedno bolje podesiti
# posebno da rotacija JWT secreta ne pokvari stare unsubscribe linkove.
UNSUBSCRIBE_SECRET=

# --- Founder / Pro pristup --------------------------------------------------
# Zarezom razdvojene email adrese (lowercase).
FOUNDER_EMAILS=founder@example.com
PRO_EMAILS=
DISCOVERY_ADMIN_EMAIL=
WAITLIST_NOTIFY_EMAIL=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
# production | staging | development — utiče na Sentry environment tag
ENVIRONMENT=production

# --- Web Push (PWA notifikacije) --------------------------------------------
# Generisati sa: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:podrska@vindex.rs

# --- Twilio (SMS / WhatsApp) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# --- Viber Bot ---------------------------------------------------------------
VIBER_AUTH_TOKEN=
VIBER_BOT_NAME=Vindex AI
VIBER_BOT_URI=vindexai

# --- Email (SMTP) -------------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# --- Rate limiting / Redis ----------------------------------------------------
# Bez ovoga slowapi radi na in-memory fallback-u (fail-open po dizajnu, v.
# tests/test_sec005_failopen_limiter.py) — OK za jedan Render instance,
# nedovoljno ako se ikad skalira na više instanci (limit se ne deli medju njima).
REDIS_URL=

# --- Limiti korišćenja (opciono — kod ima razumne podrazumevane vrednosti) ---
AGENT_BUDGET_PER_ORG_DAILY=
API_KEY_DAILY_LIMIT=
USER_AI_LIMIT_PER_HOUR=
USER_API_LIMIT_PER_HOUR=
AI_MAX_CONCURRENCY=

# --- Azure OpenAI (opcioni alternativni/fallback provider) --------------------
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# --- Integracije (Clio, iManage, Google Calendar, Etherscan) ------------------
CLIO_WEBHOOK_SECRET=
CLIO_DEFAULT_USER_ID=
IMANAGE_WEBHOOK_SECRET=
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
ETHERSCAN_API_KEY=

# --- App URL-ovi (koriste se u generisanim linkovima/emailovima) -------------
# Dve odvojene varijable, istorijski (ne namerno konsolidovano) — oba treba da
# pokazuju na isti produkcioni domen.
APP_BASE_URL=https://vindex.rs
APP_URL=https://vindex.rs

# --- Ostalo -------------------------------------------------------------------
# Vrednost jednog "boda" u RSD za obračun tarifa (routers/billing.py), default 50.
BOD_RSD=50
# SEF (Sistem elektronskih faktura) sandbox mod — "true" van produkcije.
SEF_SANDBOX=false
# OpenAI Realtime model za Vindex Live glasovnu komandu (routers/voice_realtime.py).
VINDEX_REALTIME_MODEL=gpt-4o-realtime-preview
# Render.com worker count (gunicorn/uvicorn) — podešava se u Render dashboard-u,
# ovde samo radi vidljivosti da kod čita ovu varijablu.
WEB_CONCURRENCY=

# --- Wave 9: governance prekidači ---------------------------------------------
# Cohere reranking (app/services/retrieve.py). PODRAZUMEVANO ISKLJUČENO.
# Traži SVA TRI uslova da bi se aktivirao: instaliran `cohere` paket (NIJE u
# requirements.txt), COHERE_API_KEY, i ova promenljiva. Uključivanje šalje upit i
# isečke dokumenata Cohere-u — dakle VAN kanonskog OpenAI chokepoint-a
# (shared/ai_client.py), pa i van prompt guard-a i Response Firewall-a. Kad je
# isključeno, reranking radi kroz gpt-4o-mini, koji jeste upravljan.
VINDEX_COHERE_RERANK=
# Kill switch za sirov WebSocket glasovni kanal (services/voice_orchestrator.py).
# "1" gasi kanal PRE ijednog upita ka bazi — jedini prekidač koji radi i kad je
# baza nedostupna. Ne dira HTTP glasovne rute; za njih važi red `voice` u
# feature_registry (kolona `aktivno`).
VINDEX_VOICE_KILL=
# Podrazumevani timeout po AI pozivu, u sekundama (shared/ai_client.py). Default 60.
VINDEX_LLM_TIMEOUT_S=60
