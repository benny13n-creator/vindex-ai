<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vindex AI — MS Word Add-in Manifest
  KORAK C (2026-07-24) + lokalna dev/test verifikacija (2026-07-25)

  LOKALNI DEV manifest — URL-ovi ispod NAMERNO pokazuju na
  https://localhost:8000/word_addin/... za sideload testiranje protiv
  lokalnog dev servera (v. scripts/run_word_addin_dev.py). PRE bilo kakve
  produkcione/AppSource distribucije, sledeće MORA biti zamenjeno:
    - Id element ispod je placeholder GUID (00000000-...) — generisati pravi
      (npr. `uuidgen` ili Office add-in generator) pre bilo kakvog javnog
      sideload-a/objavljivanja.
    - Sve https://localhost:8000/word_addin/... putanje zameniti sa
      https://vindex.rs/word_addin/... (ili gde god se app.py-jev
      /word_addin mount stvarno servira u produkciji).
    - AppDomains mora tačno odgovarati production domenu (danas sadrži i
      localhost i vindex.rs radi lokalnog testiranja).

  Sve navedene rute (taskpane.html, commands.html, icon-16/32/80.png) SADA
  POSTOJE u ovom direktorijumu i servira ih api.py preko
  app.mount("/word_addin", ...), ISTI FastAPI proces koji servira
  POST /api/copilot/ambient/analyze, namerno (v. taskpane.html's init(),
  koji koristi window.location.origin kao apiBase — same-origin, nema
  potrebe za CORS podešavanjem ni lokalno ni u produkciji).
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <Id>00000000-0000-0000-0000-000000000000</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Vindex AI</ProviderName>
  <DefaultLocale>sr-Latn-RS</DefaultLocale>
  <DisplayName DefaultValue="Vindex AI — Ambient Copilot" />
  <Description DefaultValue="Ambijentalni pravni asistent: kratki predlozi (članovi zakona, sudska praksa, upozorenja) dok kucate dokument u Word-u." />
  <IconUrl DefaultValue="https://localhost:8000/word_addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:8000/word_addin/icon-80.png" />
  <SupportUrl DefaultValue="https://vindex.rs/podrska" />

  <AppDomains>
    <AppDomain>https://vindex.rs</AppDomain>
    <AppDomain>https://localhost:8000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:8000/word_addin/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="VindexAmbientGroup">
                <Label resid="GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="VindexTaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>VindexAmbientTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:8000/word_addin/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:8000/word_addin/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:8000/word_addin/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://vindex.rs/podrska" />
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:8000/word_addin/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:8000/word_addin/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Vindex AI Ambient Copilot je spreman" />
        <bt:String id="GroupLabel" DefaultValue="Vindex AI" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Ambient Copilot" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Kliknite dugme da otvorite ambijentalne pravne sugestije dok kucate." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Otvori Vindex AI pravne sugestije za tekući pasus." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
